[global]
    origin = top-right
    offset = (15, 15)
    monitor = 1
    follow = none
    width = 250
    height = (0, 75)
    frame_width = 2
    frame_color = "#8e9099"
    corner_radius = 0
    background = "#111318"
    foreground = "#e2e2e9"
    separator_color= "#e2e2e9"
    separator_height = 2
    padding = 15
    horizontal_padding = 20
    icon_position = left
    max_icon_size = 32
    markup = full
    format = "<span foreground='#e2e2e9'><b>%s</b></span>\n%b"
    alignment = left
    word_wrap = yes
    sort = no
    stack_duplicates = false
    notification_limit = 1
    indicate_hidden = yes
    overlap_hide = no
    override_dbus_timeout = 3

[experimental]
    per_monitor_dpi = false

[urgency_low]
    timeout = 2
    background = "#111318E6"
    foreground = "#e2e2e9"
    frame_color = "#bfc6dc"

[urgency_normal]
    timeout = 3
    background = "#11131880"
    foreground = "#e2e2e9"
    frame_color = "#adc6ff"

[urgency_critical]
    timeout = 4
    background = "#93000AE6"
    foreground = "#ffdad6"
    frame_color = "#ffb4ab"
