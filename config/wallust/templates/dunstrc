[global]
    origin = top-right
    offset = (15, 15)
    monitor = 1
    follow = none
    width = 250
    height = (0, 75)
    frame_width = 2
    frame_color = "{{color4}}"
    corner_radius = 0
    background = "{{background}}"
    foreground = "{{foreground}}"
    separator_color= "{{foreground}}"
    separator_height = 2
    padding = 15
    horizontal_padding = 20
    icon_position = left
    max_icon_size = 32
    markup = full
    format = "<span foreground='{{foreground}}'><b>%s</b></span>\n%b"
    alignment = left
    word_wrap = yes
    sort = no
    stack_duplicates = false
    notification_limit = 1
    indicate_hidden = yes
    overlap_hide = no
    override_dbus_timeout = 3

[experimental]
    per_monitor_dpi = false

[urgency_low]
    timeout = 2
    background = "{{background | darken(0.1)}}ee"
    foreground = "{{foreground}}"
    frame_color = "{{color4}}"

[urgency_normal]
    timeout = 3
    background = "{{background | darken(0.1)}}80"
    foreground = "{{foreground}}"
    frame_color = "{{color6}}"

[urgency_critical]
    timeout = 4
    background = "{{background | darken(0.1)}}ee"
    foreground = "{{foreground}}"
    frame_color = "{{color9}}"
