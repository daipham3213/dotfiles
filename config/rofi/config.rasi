@import "colors.rasi"

configuration {
    modi:                "drun";
    display-drun:        ">";
    font:                "JetBrainsMono Nerd Font 12";
    show-icons:          false;
    lines:               6;
    width:               30;
    hover-select:        true;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
}

* {
    background-color:           @background;
    border-color: @accent;
    text-color: @accent;
    normal-background:          @background;
    normal-foreground: @accent;
    selected-normal-background: @accent;
    selected-normal-foreground: @accent-foreground;
    prompt-foreground: @accent;
    placeholder-foreground:     @placeholder;
}

window {
    width:               20%;
    background-color:    @background;
    border:              1px;
    border-color: @accent;
    border-radius:       0px;
    padding:             4px 5px;
    location:            north;
    anchor:              north;
    y-offset:            20px;
}

mainbox {
    background-color:    transparent;
    border:              0;
    padding:             2px;
    spacing:             0;
    children:            [ inputbar, listview ];
}

inputbar {
    background-color:    transparent;
    text-color: @accent;
    padding:             4px 0px;
    spacing:             0;
    children:            [ prompt, entry ];
}

prompt {
    background-color:    transparent;
    text-color: @accent;
    padding:             0px 4px 0px 0px;
    content:             ">";
}

entry {
    background-color:    transparent;
    text-color: @accent;
    placeholder-color:   @placeholder;
    placeholder:         "";
    cursor:              default;
}

listview {
    background-color:    transparent;
    border:              0;
    padding:             2px 0px 0px 0px;
    spacing:             0;
    lines:               6;
    columns:             1;
    fixed-height:        true;
    scrollbar:           false;
}

element {
    background-color:    transparent;
    text-color: @accent;
    border-radius:       0px;
    padding:             2px 4px;
    cursor:              default;
}

element alternate normal {
    background-color:    transparent;
    text-color: @accent;
}

element selected {
    background-color:    @accent;
    text-color: @accent-foreground;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
    highlight:           @accent;
    cursor:              default;
}

message {
    background-color:    transparent;
    border:              0;
    padding:             2px;
}

textbox {
    background-color:    transparent;
    text-color: @accent;
    padding:             2px 4px;
}
