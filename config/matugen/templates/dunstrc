[global]
    origin = top-right
    offset = (15, 15)
    monitor = 1
    follow = none
    width = 250
    height = (0, 75)
    frame_width = 2
    frame_color = "{{colors.outline.default.hex}}"
    corner_radius = 0
    background = "{{colors.surface.default.hex}}"
    foreground = "{{colors.on_surface.default.hex}}"
    separator_color= "{{colors.on_surface.default.hex}}"
    separator_height = 2
    padding = 15
    horizontal_padding = 20
    icon_position = left
    max_icon_size = 32
    markup = full
    format = "<span foreground='{{colors.on_surface.default.hex}}'><b>%s</b></span>\n%b"
    alignment = left
    word_wrap = yes
    sort = no
    stack_duplicates = false
    notification_limit = 1
    indicate_hidden = yes
    overlap_hide = no
    override_dbus_timeout = 3

[experimental]
    per_monitor_dpi = false

[urgency_low]
    timeout = 2
    background = "{{colors.surface.default.hex_alpha | to_color | set_alpha: 0.9 | format: "hex_alpha"}}"
    foreground = "{{colors.on_surface.default.hex}}"
    frame_color = "{{colors.secondary.default.hex}}"

[urgency_normal]
    timeout = 3
    background = "{{colors.surface.default.hex_alpha | to_color | set_alpha: 0.5 | format: "hex_alpha"}}"
    foreground = "{{colors.on_surface.default.hex}}"
    frame_color = "{{colors.primary.default.hex}}"

[urgency_critical]
    timeout = 4
    background = "{{colors.error_container.default.hex_alpha | to_color | set_alpha: 0.9 | format: "hex_alpha"}}"
    foreground = "{{colors.on_error_container.default.hex}}"
    frame_color = "{{colors.error.default.hex}}"
