/* Generated by matugen (template "rofi" -> ~/.config/rofi/colors.rasi). */

* {
    background: {{colors.surface.default.hex}};
    background-alt: {{colors.surface_container.default.hex}};
    foreground: {{colors.on_surface.default.hex}};
    accent: {{colors.primary.default.hex}};
    accent-foreground: {{colors.on_primary.default.hex}};
    placeholder: {{colors.on_surface_variant.default.hex}};
}
